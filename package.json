{
  "name": "taskdash-2-2",
  "version": "2.2.0",
  "description": "A mission-control dashboard for Obsidian tasks, projects, people, organizations, properties, meetings, and daily notes.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tasks",
    "dashboard"
  ],
  "author": "Ricardo Filho",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "obsidian": "^1.7.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "obsidian": {
      "moment": "2.31.0"
    }
  }
}
